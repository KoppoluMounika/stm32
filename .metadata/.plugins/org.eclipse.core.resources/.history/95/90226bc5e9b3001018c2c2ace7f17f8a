#include "stm32l4xx.h"
#include "uart.h"
#include "adc.h"
#include <stdio.h>

int val;

int main(void)
{
    USART2_tx_rx_init();
    pa1_adc1_init();

    while(1)
    {
        adc_start();
        val = adc_read();
        printf("ADC value: %d\r\n", val);

        for(volatile int i = 0; i < 100000; i++);
    }
}
