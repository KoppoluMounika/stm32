#include "stm32l4xx.h"
#include <string.h>

#define DMA_TCIF7 (1U << 25) // DMA1->ISR bit for Channel 7 Transfer Complete
#define DMA_CTCIF7 (1U << 25)

char message[] = "DMA UART Test\r\n";

void USART2_Init(void);
void DMA1_Channel7_Init(uint32_t src, uint32_t dst, uint32_t len);
void DMA1_Channel7_IRQHandler(void);
void delayMs(uint32_t ms);

int main(void)
{
    // Enable HSI clock
    RCC->CR |= RCC_CR_HSION;
    while (!(RCC->CR & RCC_CR_HSIRDY));

    // Use HSI as system clock
    RCC->CFGR &= ~(3U << 0);
    RCC->CFGR |= (0U << 0);
    while ((RCC->CFGR & (3U << 2)) != (0U << 2));

    USART2_Init();
    DMA1_Channel7_Init((uint32_t)message, (uint32_t)&USART2->TDR, strlen(message));

    while (1)
    {
        // Start DMA transfer
        DMA1_Channel7->CCR |= DMA_CCR_EN;
        USART2->CR3 |= USART_CR3_DMAT;

        delayMs(1000);
    }
}

void USART2_Init(void)
{
    // Enable GPIOA and USART2 clocks
    RCC->AHB2ENR |= RCC_AHB2ENR_GPIOAEN;
    RCC->APB1ENR1 |= RCC_APB1ENR1_USART2EN;

    // Set PA2 (TX) as AF7
    GPIOA->MODER &= ~(3U << (2 * 2));
    GPIOA->MODER |= (2U << (2 * 2));
    GPIOA->AFR[0] &= ~(0xFU << (4 * 2));
    GPIOA->AFR[0] |= (7U << (4 * 2));

    // USART2 configuration
    USART2->BRR = 80000000 / 115200;  // assuming 80MHz clock
    USART2->CR1 = USART_CR1_TE | USART_CR1_UE;
}

void DMA1_Channel7_Init(uint32_t src, uint32_t dst, uint32_t len)
{
    RCC->AHB1ENR |= RCC_AHB1ENR_DMA1EN;

    DMA1_Channel7->CCR &= ~DMA_CCR_EN;
    DMA1_Channel7->CPAR = dst;
    DMA1_Channel7->CMAR = src;
    DMA1_Channel7->CNDTR = len;

    DMA1_Channel7->CCR = DMA_CCR_MINC | DMA_CCR_DIR | DMA_CCR_TCIE;

    NVIC_EnableIRQ(DMA1_Channel7_IRQn);
}

void DMA1_Channel7_IRQHandler(void)
{
    if (DMA1->ISR & DMA_TCIF7)
    {
        DMA1->IFCR |= DMA_CTCIF7;  // clear flag
        DMA1_Channel7->CCR &= ~DMA_CCR_EN;  // disable channel
    }
}

void delayMs(uint32_t ms)
{
    for (uint32_t i = 0; i < ms * 4000; i++)
    {
        __NOP();
    }
}
