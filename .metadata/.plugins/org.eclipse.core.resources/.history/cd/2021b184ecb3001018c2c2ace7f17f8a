#include "adc.h"

#define GPIOAEN     (1U << 0)
#define ADC1EN      (1U << 13)

void pa1_adc1_init(void)
{
    // 1. Enable clock access to GPIOA
    RCC->AHB2ENR |= GPIOAEN;

    // 2. Set PA1 to analog mode
    GPIOA->MODER |= (3U << 2);
    GPIOA->ASCR  |= (1U << 1);  // connect analog switch

    // 3. Enable clock access to ADC
    RCC->AHB2ENR |= ADC1EN;

    // 4. Disable deep power-down and enable voltage regulator
    ADC1->CR &= ~ADC_CR_DEEPPWD;
    ADC1->CR |= ADC_CR_ADVREGEN;
    for (volatile int i = 0; i < 1000; i++); // short delay

    // 5. Calibrate ADC
    ADC1->CR &= ~ADC_CR_ADEN;
    ADC1->CR |= ADC_CR_ADCAL;
    while (ADC1->CR & ADC_CR_ADCAL);

    // 6. Enable ADC
    ADC1->CR |= ADC_CR_ADEN;
    while (!(ADC1->ISR & ADC_ISR_ADRDY));

    // 7. Configure ADC channel sequence (PA1 → channel 6)
    ADC1->SQR1 &= ~(0x1F);
    ADC1->SQR1 |= 6U;

    // 8. Enable continuous conversion mode
    ADC1->CFGR |= ADC_CFGR_CONT;

    // 9. Enable ADC
    ADC1->CR |= ADC_CR_ADSTART;
}

void adc_start(void)
{
    ADC1->CR |= ADC_CR_ADSTART;
}

uint32_t adc_read(void)
{
    while (!(ADC1->ISR & ADC_ISR_EOC));  // wait end of conversion
    return ADC1->DR;
}
