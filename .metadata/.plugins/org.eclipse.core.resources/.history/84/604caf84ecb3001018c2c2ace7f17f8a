#include "stm32l4xx.h"
#include "uart.h"
#include "adc.h"
#include <stdio.h>

int main(void)
{
    uint32_t val;

    USART2_tx_rx_init();
    printf("UART OK\r\n");

    pa1_adc1_init();
    printf("ADC OK\r\n");

    while (1)
    {
        adc_start();
        val = adc_read();
        printf("ADC Value: %lu\r\n", val);

        for (volatile int i = 0; i < 100000; i++);  // small delay
    }
}
