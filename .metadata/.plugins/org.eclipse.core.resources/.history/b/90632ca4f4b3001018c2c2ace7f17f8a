#include "stm32l4xx.h"

void USART2_Init(void);

int main(void)
{
    USART2_Init();

    while(1)
    {
        const char msg[] = "Hello STM32\r\n";
        for (int i = 0; msg[i] != '\0'; i++)
        {
            while (!(USART2->ISR & (1 << 7))); // TXE
            USART2->TDR = msg[i];
        }

        for (volatile int i = 0; i < 1000000; i++); // small delay
    }
}

void USART2_Init(void)
{
    /* Enable GPIOA clock */
    RCC->AHB2ENR |= RCC_AHB2ENR_GPIOAEN;

    /* Set PA2, PA3 to AF7 (USART2) */
    GPIOA->MODER &= ~((3U << (2*2)) | (3U << (3*2)));
    GPIOA->MODER |= ((2U << (2*2)) | (2U << (3*2)));
    GPIOA->AFR[0] |= (7U << (4*2)) | (7U << (4*3));

    /* Enable USART2 clock */
    RCC->APB1ENR1 |= RCC_APB1ENR1_USART2EN;

    /* Configure baud rate for 16MHz / 115200 */
    USART2->BRR = 0x8B;

    /* Enable TX, RX, and USART */
    USART2->CR1 = USART_CR1_TE | USART_CR1_RE | USART_CR1_UE;
}
