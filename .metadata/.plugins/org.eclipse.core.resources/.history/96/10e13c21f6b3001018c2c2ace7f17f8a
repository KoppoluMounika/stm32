#include "stm32l4xx.h"
#include <stdio.h>

void uart2_tx_init(void);
int __io_putchar(int ch);

int main(void)
{
    uart2_tx_init();
    printf("Hello from STM32!\r\n");

    while (1)
    {
    }
}

void uart2_tx_init(void)
{
    // Enable GPIOA clock and USART2 clock
    RCC->AHB2ENR |= (1U << 0);
    RCC->APB1ENR1 |= (1U << 17);

    // Set PA2 to alternate function (AF7)
    GPIOA->MODER &= ~(3U << (2 * 2));
    GPIOA->MODER |= (2U << (2 * 2));
    GPIOA->AFR[0] |= (7U << (4 * 2));

    // Configure USART2
    USART2->BRR = 0x1A1; // for 80 MHz, 115200 baud
    USART2->CR1 = (1U << 3) | (1U << 0); // TE, UE enable
}

int __io_putchar(int ch)
{
    while (!(USART2->ISR & (1U << 7))); // wait until TXE=1
    USART2->TDR = (ch & 0xFF);
    return ch;
}
