#include "stm32l4xx.h"
#include "uart.h"
#include <stdio.h>

#define GPIOAEN      RCC_AHB2ENR_GPIOAEN
#define USART2EN     RCC_APB1ENR1_USART2EN
#define SYS_FREQ     4000000
#define APB1_CLK     SYS_FREQ
#define UART_BAUDRATE 115200

static void uart_set_baudrate(USART_TypeDef *USARTx, uint32_t PeriphClk, uint32_t BaudRate);
static uint16_t compute_uart_bd(uint32_t PeriphClk, uint32_t BaudRate);

int __io_putchar(int ch)
{
    // Wait until TXE (Transmit data register empty)
    while(!(USART2->ISR & USART_ISR_TXE));
    USART2->TDR = (ch & 0xFF);
    return ch;
}

void USART2_tx_rx_init(void)
{
    /************* Configure UART GPIO Pins *************/
    RCC->AHB2ENR |= GPIOAEN;

    // PA2 -> USART2_TX, PA3 -> USART2_RX
    GPIOA->MODER &= ~((3U << 4) | (3U << 6));  // Clear mode
    GPIOA->MODER |=  (2U << 4) | (2U << 6);    // Alternate mode

    GPIOA->AFR[0] &= ~((0xF << 8) | (0xF << 12));
    GPIOA->AFR[0] |=  (7U << 8) | (7U << 12);  // AF7 (USART2)

    GPIOA->OSPEEDR |= (3U << 4) | (3U << 6);   // High speed
    GPIOA->PUPDR &= ~((3U << 4) | (3U << 6));  // No pull-up/pull-down

    /************* Configure UART Module *************/
    RCC->APB1ENR1 |= USART2EN;  // Enable USART2 clock

    USART2->CR1 = 0;             // Disable before config
    uart_set_baudrate(USART2, APB1_CLK, UART_BAUDRATE);
    USART2->CR1 = USART_CR1_TE | USART_CR1_RE;  // TX, RX enable
    USART2->CR1 |= USART_CR1_UE;                // Enable USART
}

static void uart_set_baudrate(USART_TypeDef *USARTx, uint32_t PeriphClk, uint32_t BaudRate)
{
    USARTx->BRR = compute_uart_bd(PeriphClk, BaudRate);
}

static uint16_t compute_uart_bd(uint32_t PeriphClk, uint32_t BaudRate)
{
    return ((PeriphClk + (BaudRate / 2U)) / BaudRate);
}
