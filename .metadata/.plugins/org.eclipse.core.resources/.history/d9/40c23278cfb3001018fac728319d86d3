#include "stm32l476xx.h"

void UART2_Init(void);
void UART2_SendChar(char c);
void UART2_SendString(char *str);

int main(void)
{
    UART2_Init();

    while (1)
    {
        UART2_SendString("Hello STM32\r\n");
        for (volatile int i = 0; i < 1000000; i++); // delay
    }
}

void UART2_Init(void)
{
    // Enable clocks
    RCC->APB1ENR1 |= RCC_APB1ENR1_USART2EN;
    RCC->AHB2ENR  |= RCC_AHB2ENR_GPIOAEN;

    // Configure PA2 -> TX, PA3 -> RX
    GPIOA->MODER &= ~(GPIO_MODER_MODE2 | GPIO_MODER_MODE3);
    GPIOA->MODER |=  (0x2 << GPIO_MODER_MODE2_Pos) | (0x2 << GPIO_MODER_MODE3_Pos);
    GPIOA->AFR[0] |= (7 << GPIO_AFRL_AFSEL2_Pos) | (7 << GPIO_AFRL_AFSEL3_Pos);

    // Configure USART2 (115200 baud, 8N1)
    USART2->BRR = 0x8B;                 // 115200 @ 16 MHz
    USART2->CR1 = USART_CR1_TE | USART_CR1_UE;  // Enable TX and USART
}

void UART2_SendChar(char c)
{
    while (!(USART2->ISR & USART_ISR_TXE));  // Wait for TX buffer empty
    USART2->TDR = c;
}

void UART2_SendString(char *str)
{
    while (*str)
    {
        UART2_SendChar(*str++);
    }
}
