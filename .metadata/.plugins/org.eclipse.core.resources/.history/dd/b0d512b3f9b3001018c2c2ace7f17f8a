#include "stm32l4xx.h"
#include <stdio.h>

void uart2_tx_init(void);
void uart2_write(int ch);
void systick_delay_ms(uint32_t delay);
void adc1_init(void);
uint32_t adc1_read(void);

int __io_putchar(int ch)
{
    uart2_write(ch);
    return ch;
}

int main(void)
{
    uart2_tx_init();
    adc1_init();

    printf("ADC + UART Test Started\r\n");

    while (1)
    {
        uint32_t adc_val = adc1_read();
        float voltage = (adc_val * 3.3f) / 4095.0f;
        printf("ADC = %lu, Voltage = %.2f V\r\n", adc_val, voltage);
        systick_delay_ms(1000);
    }
}

void uart2_tx_init(void)
{
    RCC->AHB2ENR |= (1U << 0); // GPIOA clock enable
    RCC->APB1ENR1 |= (1U << 17); // USART2 clock enable

    // PA2 -> AF7 (USART2_TX)
    GPIOA->MODER &= ~(3U << (2 * 2));
    GPIOA->MODER |=  (2U << (2 * 2));
    GPIOA->AFR[0]  &= ~(0xFU << (4 * 2));
    GPIOA->AFR[0]  |=  (7U << (4 * 2));

    // Baud rate: 115200 @16MHz
    USART2->BRR = 139;

    USART2->CR1 = (1U << 3);  // TE
    USART2->CR1 |= (1U << 0); // UE
}

void uart2_write(int ch)
{
    while (!(USART2->ISR & (1U << 7))); // Wait for TXE
    USART2->TDR = (ch & 0xFF);
}

void systick_delay_ms(uint32_t delay)
{
    SysTick->LOAD = 16000 - 1; // 1ms at 16MHz
    SysTick->VAL  = 0;
    SysTick->CTRL = 5; // Enable, no interrupt

    for (uint32_t i = 0; i < delay; i++)
    {
        while ((SysTick->CTRL & (1 << 16)) == 0);
    }
    SysTick->CTRL = 0;
}

void adc1_init(void)
{
    // Enable GPIOA and ADC clock
    RCC->AHB2ENR |= (1U << 0);  // GPIOA clock
    RCC->AHB2ENR |= (1U << 13); // ADC clock

    // Set PA0 (ADC1_IN5) as analog
    GPIOA->MODER |= (3U << (0 * 2));
    GPIOA->ASCR  |= (1U << 0);

    // Enable ADC voltage regulator
    ADC1->CR &= ~(1U << 29);
    ADC1->CR |= (1U << 28);
    for (volatile int i = 0; i < 1000; i++);

    // Calibrate ADC
    ADC1->CR |= (1U << 31);
    while (ADC1->CR & (1U << 31));

    // Enable ADC
    ADC1->ISR |= (1U << 0);
    ADC1->CR  |= (1U << 0);
    while (!(ADC1->ISR & (1U << 0)));

    // Channel 5, 12-bit, single conversion
    ADC1->SQR1 &= ~0x1F;
    ADC1->SQR1 |= 5;  // channel 5 (PA0)
}

uint32_t adc1_read(void)
{
    ADC1->CR |= (1U << 2);             // Start conversion
    while (!(ADC1->ISR & (1U << 2)));  // Wait EOC
    return ADC1->DR;                   // Read value
}
