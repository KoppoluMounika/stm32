#include "uart.h"

#define GPIOAEN     (1U << 0)
#define USART2EN    (1U << 17)

#define SYS_FREQ        16000000U   // HSI16 frequency
#define UART_BAUDRATE   115200U

#define CR1_TE      (1U << 3)
#define CR1_RE      (1U << 2)
#define CR1_UE      (1U << 0)

#define ISR_TXE     (1U << 7)
#define ISR_RXNE    (1U << 5)

static void uart_set_baudrate(USART_TypeDef *USARTx, uint32_t PeriphClk, uint32_t BaudRate);
static uint16_t compute_uart_bd(uint32_t PeriphClk, uint32_t BaudRate);

int __io_putchar(int ch)
{
    uart2_write(ch);
    return ch;
}

int __io_getchar(void)
{
    return uart2_read();
}

void USART2_tx_rx_init(void)
{
    /*********** Enable HSI16 ***********/
    RCC->CR |= RCC_CR_HSION;
    while (!(RCC->CR & RCC_CR_HSIRDY));

    /*********** Configure UART2 GPIO pins ***********/
    RCC->AHB2ENR |= (1U << 0);   // Enable GPIOA clock

    // PA2 -> AF7 (USART2_TX)
    GPIOA->MODER &= ~(3U << (2 * 2));
    GPIOA->MODER |=  (2U << (2 * 2));
    GPIOA->AFR[0] &= ~(0xF << (4 * 2));
    GPIOA->AFR[0] |=  (7U << (4 * 2));

    // PA3 -> AF7 (USART2_RX)
    GPIOA->MODER &= ~(3U << (3 * 2));
    GPIOA->MODER |=  (2U << (3 * 2));
    GPIOA->AFR[0] &= ~(0xF << (4 * 3));
    GPIOA->AFR[0] |=  (7U << (4 * 3));

    /************* Configure USART2 *************/
    RCC->APB1ENR1 |= (1U << 17);  // Enable USART2 clock

    // Explicitly select **HSI16** as USART2 clock source
    RCC->CCIPR &= ~(3U << 2);
    RCC->CCIPR |=  (2U << 2);     // 10: HSI16 selected as clock source

    // Enable USART2 before changing BRR
    USART2->CR1 &= ~((1U << 0));  // Disable USART before config

    // Configure baudrate for 115200 with 16 MHz
    USART2->BRR = 16000000 / 115200;

    // Enable TX and RX
    USART2->CR1 |= (1U << 3) | (1U << 2);

    // Enable USART2
    USART2->CR1 |= (1U << 0);
}


void uart2_write(int ch)
{
    while (!(USART2->ISR & ISR_TXE));  // Wait until TX buffer empty
    USART2->TDR = (ch & 0xFF);
}

char uart2_read(void)
{
    while (!(USART2->ISR & ISR_RXNE));  // Wait until data received
    return (char)(USART2->RDR & 0xFF);
}

static void uart_set_baudrate(USART_TypeDef *USARTx, uint32_t PeriphClk, uint32_t BaudRate)
{
    USARTx->BRR = compute_uart_bd(PeriphClk, BaudRate);
}

static uint16_t compute_uart_bd(uint32_t PeriphClk, uint32_t BaudRate)
{
    return ((PeriphClk + (BaudRate / 2U)) / BaudRate);
}
