#include "stm32l4xx.h"

#define GPIOAEN   (1U << 0)
#define GPIOCEN   (1U << 2)
#define PIN5      (1U << 5)
#define PIN13     (1U << 13)
#define LED_PIN   PIN5
#define BTN_PIN   PIN13

void pc13_exti_init(void);
void EXTI15_10_IRQHandler(void);

int main(void)
{
    // Enable GPIOA (for LED) and GPIOC (for button)
    RCC->AHB2ENR |= GPIOAEN;
    RCC->AHB2ENR |= GPIOCEN;

    // Set PA5 as output (LED)
    GPIOA->MODER &= ~(3U << (5 * 2));  // Clear mode bits
    GPIOA->MODER |=  (1U << (5 * 2));  // Set as general purpose output

    // Initialize external interrupt for PC13 (User button)
    pc13_exti_init();

    while (1)
    {
        // main loop does nothing, LED controlled by interrupt
    }
}

// Configure EXTI for PC13
void pc13_exti_init(void)
{
    // Configure PC13 as input (button)
    GPIOC->MODER &= ~(3U << (13 * 2));

    // Enable SYSCFG clock
    RCC->APB2ENR |= RCC_APB2ENR_SYSCFGEN;

    // Select port C for EXTI13
    SYSCFG->EXTICR[3] &= ~(0xFU << 4); // clear bits for EXTI13
    SYSCFG->EXTICR[3] |=  (0x2U << 4); // select port C (0x2)

    // Unmask EXTI line 13
    EXTI->IMR1 |= BTN_PIN;

    // Trigger on falling edge (button press)
    EXTI->FTSR1 |= BTN_PIN;

    // Disable rising edge trigger
    EXTI->RTSR1 &= ~BTN_PIN;

    // Enable interrupt line in NVIC
    NVIC_EnableIRQ(EXTI15_10_IRQn);
}

// Interrupt Service Routine for EXTI line [15:10]
void EXTI15_10_IRQHandler(void)
{
    if (EXTI->PR1 & BTN_PIN)
    {
        // Clear interrupt flag
        EXTI->PR1 |= BTN_PIN;

        // Toggle LED
        GPIOA->ODR ^= LED_PIN;
    }
}
