#include "stm32l4xx.h"
#include <stdio.h>

#define GPIOAEN     (1U << 0)
#define USART2EN    (1U << 17)
#define SYS_FREQ    16000000
#define APB1_CLK    SYS_FREQ
#define UART_BAUDRATE 9600

void uart2_tx_init(void);
void uart2_write(int ch);
static void uart_set_baudrate(USART_TypeDef *USARTx, uint32_t PeriphClk, uint32_t BaudRate);
static uint16_t compute_uart_bd(uint32_t PeriphClk, uint32_t BaudRate);

int main(void)
{
    uart2_tx_init();

    while (1)
    {
        const char msg[] = "Hello from STM32L4 UART!\r\n";
        const char *p = msg;
        while (*p)
        {
            uart2_write(*p++);
        }

        for (volatile int i = 0; i < 1000000; i++);  // small delay
    }
}

void uart2_tx_init(void)
{
    /* Enable clock access to GPIOA */
    RCC->AHB2ENR |= GPIOAEN;

    /* Set PA2 mode to alternate function */
    GPIOA->MODER &= ~(3U << 4);
    GPIOA->MODER |=  (2U << 4);

    /* Set alternate function type to AF7 (USART2_TX) */
    GPIOA->AFRL &= ~(0xF << 8);   // use AFRL for PA0–PA7
    GPIOA->AFRL |=  (7 << 8);     // AF7 on PA2

    /* Enable clock access to USART2 */
    RCC->APB1ENR1 |= USART2EN;

    /* Configure baud rate */
    uart_set_baudrate(USART2, APB1_CLK, UART_BAUDRATE);

    /* Enable transmitter and USART module */
    USART2->CR1 = (1U << 3) | (1U << 0);
}

void uart2_write(int ch)
{
    /* Wait until transmit data register is empty */
    while (!(USART2->ISR & (1U << 7))) {}
    USART2->TDR = (ch & 0xFF);
}

static void uart_set_baudrate(USART_TypeDef *USARTx, uint32_t PeriphClk, uint32_t BaudRate)
{
    USARTx->BRR = compute_uart_bd(PeriphClk, BaudRate);
}

static uint16_t compute_uart_bd(uint32_t PeriphClk, uint32_t BaudRate)
{
    return (PeriphClk + (BaudRate / 2U)) / BaudRate;
}
