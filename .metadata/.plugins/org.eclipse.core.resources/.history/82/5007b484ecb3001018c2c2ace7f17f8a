#include "uart.h"

#define GPIOAEN     (1U << 0)
#define USART2EN    (1U << 17)
#define SYS_FREQ    4000000
#define APB1_CLK    SYS_FREQ
#define UART_BAUDRATE 115200

#define CR1_TE      (1U << 3)
#define CR1_UE      (1U << 0)
#define ISR_TXE     (1U << 7)

static uint16_t compute_uart_bd(uint32_t PeriphClk, uint32_t BaudRate)
{
    return (PeriphClk + (BaudRate/2U)) / BaudRate;
}

void USART2_tx_rx_init(void)
{
    /* Enable clock access to GPIOA */
    RCC->AHB2ENR |= GPIOAEN;

    /* Set PA2 (TX) and PA3 (RX) to alternate function mode */
    GPIOA->MODER &= ~((3U << 4) | (3U << 6));
    GPIOA->MODER |=  ((2U << 4) | (2U << 6));

    /* Set alternate function type to AF7 (USART2) */
    GPIOA->AFR[0] |=  (7U << 8);
    GPIOA->AFR[0] |=  (7U << 12);

    /* Enable clock access to USART2 */
    RCC->APB1ENR1 |= USART2EN;

    /* Configure baud rate */
    USART2->BRR = compute_uart_bd(APB1_CLK, UART_BAUDRATE);

    /* Enable transmitter */
    USART2->CR1 = CR1_TE;

    /* Enable USART module */
    USART2->CR1 |= CR1_UE;
}

void uart2_write(int ch)
{
    while (!(USART2->ISR & ISR_TXE));  // Wait until transmit data register empty
    USART2->TDR = (ch & 0xFF);
}

int __io_putchar(int ch)
{
    uart2_write(ch);
    return ch;
}
