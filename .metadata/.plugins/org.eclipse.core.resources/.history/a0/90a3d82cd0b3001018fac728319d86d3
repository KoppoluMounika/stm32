#include "stm32l4xx.h"

void UART2_Init(void);
void UART2_SendChar(char c);
void UART2_SendString(char *str);

int main(void)
{
    UART2_Init();

    while (1)
    {
        UART2_SendString("Hello STM32\r\n");
        for (volatile int i = 0; i < 1000000; i++); // delay
    }
}

void UART2_Init(void)
{
    // Enable clocks
    RCC->APB1ENR1 |= (1 << 17);    // USART2EN bit position = 17
    RCC->AHB2ENR  |= (1 << 0);     // GPIOAEN bit position = 0

    // Configure PA2 (TX), PA3 (RX) as Alternate Function (AF7)
    GPIOA->MODER &= ~((3 << (2 * 2)) | (3 << (3 * 2)));  // Clear mode bits
    GPIOA->MODER |=  ((2 << (2 * 2)) | (2 << (3 * 2)));  // Set to AF mode
    GPIOA->AFR[0] &= ~((0xF << (4 * 2)) | (0xF << (4 * 3)));
    GPIOA->AFR[0] |=  ((7 << (4 * 2)) | (7 << (4 * 3)));  // AF7 = USART2

    // Configure USART2 (115200 baud @ 16MHz)
    USART2->BRR = 0x8B;                 // 16 MHz / 115200 ≈ 139 (0x8B)
    USART2->CR1 = USART_CR1_TE | USART_CR1_UE;  // Enable TX + USART
}


void UART2_SendChar(char c)
{
    while (!(USART2->ISR & USART_ISR_TXE));  // Wait for TX buffer empty
    USART2->TDR = c;
}

void UART2_SendString(char *str)
{
    while (*str)
    {
        UART2_SendChar(*str++);
    }
}
