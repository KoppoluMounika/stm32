void USART2_tx_init(void)
{
    /* Enable clock access to GPIOA */
    RCC->AHB2ENR |= (1U << 0);

    /* Set PA2 mode to alternate function */
    GPIOA->MODER &= ~((3U << 4) | (3U << 6));
    GPIOA->MODER |=  ((2U << 4) | (2U << 6));

    /* Set alternate function type to AF7 (USART2) */
    GPIOA->AFR[0] |=  (7U << 8);
    GPIOA->AFR[0] |=  (7U << 12);

    /* Enable clock access to USART2 */
    RCC->APB1ENR1 |= (1U << 17);

    /* Configure baud rate */
    USART2->BRR = 35;    // 👈 CHANGE THIS LINE HERE

    /* Configure transfer direction */
    USART2->CR1 = (1U << 3);   // TE = Transmit enable

    /* Enable USART2 */
    USART2->CR1 |= (1U << 0);  // UE = USART enable
}


void uart2_write(int ch)
{
    while (!(USART2->ISR & ISR_TXE));  // Wait until TX buffer empty
    USART2->TDR = (ch & 0xFF);
}

char uart2_read(void)
{
    while (!(USART2->ISR & ISR_RXNE));  // Wait until RXNE (data ready)
    return (char)(USART2->RDR & 0xFF);
}

static void uart_set_baudrate(USART_TypeDef *USARTx, uint32_t PeriphClk, uint32_t BaudRate)
{
    USARTx->BRR = compute_uart_bd(PeriphClk, BaudRate);
}

static uint16_t compute_uart_bd(uint32_t PeriphClk, uint32_t BaudRate)
{
    return ((PeriphClk) + (BaudRate / 2U)) / BaudRate;
}
