/* USER CODE BEGIN Header */
/**
  ******************************************************************************
  * @file           : main.c
  * @brief          : SPI Loopback Test (STM32L476 HAL)
  ******************************************************************************
  * @attention
  *
  * Connect SPI1 MOSI (PA7) -> MISO (PA6)
  * LED toggles every 500ms when SPI TX/RX data matches
  *
  ******************************************************************************
  */
/* USER CODE END Header */

#include "main.h"
#include "spi.h"
#include "gpio.h"
#include <string.h>

/* Private variables ---------------------------------------------------------*/
uint8_t tx_buffer[5] = { 'H', 'E', 'L', 'L', 'O' };
uint8_t rx_buffer[5];

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
void Error_Handler(void);

/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{
  /* MCU Configuration--------------------------------------------------------*/
  HAL_Init();
  SystemClock_Config();

  MX_GPIO_Init();
  MX_SPI1_Init();

  /* Infinite loop */
  while (1)
  {
    // Send & receive via SPI (loopback test)
    if (HAL_SPI_TransmitReceive(&hspi1, tx_buffer, rx_buffer, sizeof(tx_buffer), HAL_MAX_DELAY) == HAL_OK)
    {
      // Compare transmitted and received data
      if (memcmp(tx_buffer, rx_buffer, sizeof(tx_buffer)) == 0)
      {
        // Toggle LED on successful loopback
        HAL_GPIO_TogglePin(GPIOB, GPIO_PIN_13);
        HAL_Delay(500);
      }
    }
    else
    {
      Error_Handler();
    }
  }
}

