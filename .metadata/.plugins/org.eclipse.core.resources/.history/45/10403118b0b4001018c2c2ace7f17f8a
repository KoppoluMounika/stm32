#include "stm32l4xx.h"
#include <stdio.h>

void USART2_tx_init(void);
void uart2_write(int ch);
int __io_putchar(int ch);

int main(void)
{
    USART2_tx_init();
    while (1)
    {
        printf("Hello from STM32\r\n");
        for (volatile int i = 0; i < 1000000; i++);
    }
}

int __io_putchar(int ch)
{
    uart2_write(ch);
    return ch;
}

void USART2_tx_init(void)
{
    RCC->AHB2ENR |= (1U << 0);   // Enable GPIOA clock
    RCC->APB1ENR1 |= (1U << 17); // Enable USART2 clock

    // PA2 (TX) alternate function AF7
    GPIOA->MODER &= ~(3U << 4);
    GPIOA->MODER |=  (2U << 4);
    GPIOA->AFR[0] &= ~(0xFU << 8);
    GPIOA->AFR[0] |=  (7U  << 8);

    // HSI16 as USART2 clock
    RCC->CCIPR &= ~(3U << 2);
    RCC->CCIPR |=  (2U << 2);

    // Baudrate = 115200 for 16 MHz clock
    USART2->BRR = 16000000 / 115200;

    // Enable TX and USART
    USART2->CR1 = (1U << 3) | (1U << 0);
}

void uart2_write(int ch)
{
    while (!(USART2->ISR & (1U << 7))); // Wait until TXE
    USART2->TDR = (ch & 0xFF);
}
