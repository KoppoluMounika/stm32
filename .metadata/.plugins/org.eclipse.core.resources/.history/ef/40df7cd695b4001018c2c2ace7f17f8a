#include "stm32l4xx.h"
#include <string.h>

#define BUF_SIZE 32

char dma_buf[BUF_SIZE] = "Hello from STM32 DMA!\r\n";

void Clock_Config(void);
void USART2_DMA_Init(void);
void DMA1_Channel7_IRQHandler(void);

int main(void)
{
    Clock_Config();
    USART2_DMA_Init();

    while (1)
    {
        // Start DMA transfer (USART2 TX)
        DMA1_Channel7->CCR &= ~DMA_CCR_EN;  // Disable DMA
        DMA1_Channel7->CNDTR = strlen(dma_buf);
        DMA1_Channel7->CMAR = (uint32_t)dma_buf;
        DMA1_Channel7->CCR |= DMA_CCR_EN;   // Enable DMA
        for (volatile int i = 0; i < 1000000; i++); // small delay
    }
}

/* ===================== CLOCK CONFIG ===================== */
void Clock_Config(void)
{
    RCC->CR |= RCC_CR_HSION;
    while (!(RCC->CR & RCC_CR_HSIRDY));

    RCC->CFGR &= ~RCC_CFGR_SW;
    RCC->CFGR |= RCC_CFGR_SW_HSI;
    while ((RCC->CFGR & RCC_CFGR_SWS) != RCC_CFGR_SWS_HSI);
}

/* ===================== USART2 + DMA ===================== */
void USART2_DMA_Init(void)
{
    /* 1. Enable Clocks */
    RCC->AHB2ENR |= RCC_AHB2ENR_GPIOAEN;
    RCC->AHB1ENR |= RCC_AHB1ENR_DMA1EN;
    RCC->APB1ENR1 |= RCC_APB1ENR1_USART2EN;

    /* 2. Configure PA2 (TX), PA3 (RX) for AF7 */
    GPIOA->MODER &= ~((3U << (2 * 2)) | (3U << (3 * 2)));
    GPIOA->MODER |=  (2U << (2 * 2)) | (2U << (3 * 2));
    GPIOA->AFRL  &= ~((0xF << 8) | (0xF << 12));
    GPIOA->AFRL  |=  (7U << 8) | (7U << 12);

    /* 3. Configure USART2: 115200 baud @16 MHz */
    USART2->BRR = 16000000 / 115200;
    USART2->CR3 |= USART_CR3_DMAT;      // enable DMA for TX
    USART2->CR1 = USART_CR1_TE | USART_CR1_UE;

    /* 4. Configure DMA1 Channel7 for USART2_TX */
    DMA1_Channel7->CCR &= ~DMA_CCR_EN;
    DMA1_Channel7->CPAR = (uint32_t)&USART2->TDR;
    DMA1_Channel7->CMAR = (uint32_t)dma_buf;
    DMA1_Channel7->CNDTR = strlen(dma_buf);
    DMA1_Channel7->CCR = DMA_CCR_DIR | DMA_CCR_MINC | DMA_CCR_TCIE;

    /* Channel mapping: USART2_TX -> DMA1_CH7 */
    DMA1_CSELR->CSELR &= ~(0xF << 24);
    DMA1_CSELR->CSELR |=  (4U << 24);  // channel7: request 4 (USART2_TX)

    /* Enable DMA interrupt */
    NVIC_EnableIRQ(DMA1_Channel7_IRQn);
}

/* ===================== DMA ISR ===================== */
void DMA1_Channel7_IRQHandler(void)
{
    if (DMA1->ISR & DMA_ISR_TCIF7)
    {
        DMA1->IFCR |= DMA_IFCR_CTCIF7;  // clear TC flag
        DMA1_Channel7->CCR &= ~DMA_CCR_EN; // disable channel
    }
}
